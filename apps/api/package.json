{
  "name": "@shopmock/api",
  "version": "1.0.0",
  "private": true,
  "description": "ShopMock API backend built with TypeScript and Express",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}

