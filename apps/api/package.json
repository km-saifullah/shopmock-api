{
  "name": "@shopmock/api",
  "version": "1.0.0",
  "private": true,
  "description": "ShopMock API backend built with TypeScript and Express",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:watch": "vitest --maxWorkers=1 --minWorkers=1",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:categories": "npm run build && node dist/scripts/seed-categories.js",
    "seed:products": "npm run build && node dist/scripts/seed-products.js",
    "seed:all": "npm run build && node dist/scripts/seed-all.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.1",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.36.0",
    "supertest": "^7.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
