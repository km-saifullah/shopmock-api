{
  "name": "shopmock-api",
  "version": "1.0.0",
  "private": true,
  "description": "A developer-first e-commerce mock API SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace=@shopmock/api",
    "dev:web": "npm run dev --workspace=@shopmock/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}

